# Copy this file to .env and fill in values from `npx supabase status`
# (local dev) or your Supabase project's API settings (staging/prod).
# EXPO_PUBLIC_ vars are inlined into the JS bundle at build time by Expo,
# so only ever put the anon/public key here, never a service role key.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
